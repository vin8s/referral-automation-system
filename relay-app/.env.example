# Relay environment variables
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in what you need:
#     cp .env.example .env.local
# .env.local is gitignored. NEVER commit real secrets, and never put real
# patient data anywhere until the AWS BAA is signed.
#
# For local development you can leave EVERYTHING blank: `npm run dev` uses an
# embedded database and a mock login screen.

# ── App ──────────────────────────────────────────────────────────────────────

# Public base URL of the app. Used to build the Cognito redirect URI.
# Dev default: http://localhost:3000. REQUIRED in production.
APP_URL=

# Time zone used to display all dates/times (the clinic's local time).
# Default: America/Los_Angeles
CLINIC_TIMEZONE=

# Hours after the last eCW schedule import before the amber "schedule data may be
# stale" warning shows on the dashboard and confirm queue. Default: 24.
ECW_IMPORT_STALE_HOURS=

# ── Database ─────────────────────────────────────────────────────────────────

# Postgres connection string. Leave blank in development to use the embedded
# PGlite database stored in relay-app/.data/pglite (no install needed).
# REQUIRED in production (AWS RDS).
#   Local Postgres.app example:  postgres://localhost:5432/relay
#   RDS example:                 postgres://relay_app:PASSWORD@relay-db.xxxx.us-east-2.rds.amazonaws.com:5432/relay
# Don't add ?sslmode=... here; use DATABASE_SSL below instead.
DATABASE_URL=

# TLS for DATABASE_URL connections:
#   off      - no TLS (local Postgres on your Mac). Default.
#   require  - encrypted, server certificate NOT verified.
#   verify   - encrypted and certificate verified (use this for RDS, together
#              with DATABASE_SSL_CA_FILE pointing at the AWS RDS CA bundle,
#              e.g. global-bundle.pem from https://truststore.pki.rds.amazonaws.com).
DATABASE_SSL=
DATABASE_SSL_CA_FILE=

# Max pooled connections per server instance. Default: 5
DATABASE_POOL_MAX=

# Where the embedded dev database lives. Default: ./.data/pglite
PGLITE_DIR=

# Production normally runs `npm run db:migrate` as a deploy step. Set to true to
# instead apply pending migrations automatically on the first request.
# (Development always auto-migrates and auto-seeds fake data.)
DB_AUTO_MIGRATE=

# ── Authentication ───────────────────────────────────────────────────────────

# 'mock' or 'cognito'. Leave blank: Cognito if COGNITO_ISSUER + COGNITO_CLIENT_ID
# are set, otherwise mock. Mock login is IMPOSSIBLE with NODE_ENV=production
# (`next build` / `next start`): the server refuses and nobody can sign in.
AUTH_MODE=

# Secret used to sign session cookies. REQUIRED in production, 32+ random chars.
# Generate one with:  openssl rand -base64 32
# (Dev uses a built-in throwaway value if blank.)
AUTH_SECRET=

# How long a sign-in lasts, in hours. Default: 8 (one shift)
SESSION_HOURS=

# Amazon Cognito (production). From the AWS console → Cognito → your user pool:
#   Issuer:    https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
#   Client ID / secret: App integration → App clients (confidential client,
#   authorization-code grant, scopes openid email profile,
#   callback URL  <APP_URL>/api/auth/callback,
#   sign-out URL  <APP_URL>/login).
COGNITO_ISSUER=
COGNITO_CLIENT_ID=
COGNITO_CLIENT_SECRET=

# Hosted UI domain, used to also sign out of Cognito on "Sign out".
# e.g. https://relay-clinic.auth.us-east-2.amazoncognito.com
COGNITO_DOMAIN=

# Cognito groups that map to Relay roles. Users in neither group can't sign in.
# Defaults: admin / ma
COGNITO_ADMIN_GROUP=
COGNITO_MA_GROUP=

# OIDC scopes. Default: openid email profile
COGNITO_SCOPES=

# ── SMS texting (the pilot channel) ──────────────────────────────────────────
# Leave all of these blank for local development: texts are recorded in the
# database only (no network), the AI is a rule-based stand-in, and a "Patient
# simulator (prototype)" box on each referral lets you reply as the patient.

# 'mock' (default), 'aws' (AWS End User Messaging SMS, SendTextMessage), or
# 'twilio' (LOCAL TESTING ONLY with fake data: no BAA with Twilio; refused in production).
SMS_PROVIDER=

# --- Twilio test mode (SMS_PROVIDER=twilio) ---------------------------------
# For texting your own phone while the AWS toll-free number is being verified.
# Only numbers in TWILIO_TEST_ALLOWED_NUMBERS can ever receive a text. Fake patients only.
# Values: Twilio Console home page (Account SID / Auth Token) and your Twilio number.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Comma-separated approved test phones, e.g. +15550100001, +15550100002
TWILIO_TEST_ALLOWED_NUMBERS=
# Replies: the exact public URL set as the Twilio number's "A message comes in" webhook,
# e.g. https://<your-tunnel>/api/sms/twilio/inbound (signatures are checked against it).
TWILIO_WEBHOOK_URL=

# AWS region for End User Messaging and Bedrock: us-east-2 (Ohio), the project's home Region.
# Credentials come from the standard AWS chain (ECS task role in production).
AWS_REGION=

# The phone number (E.164, e.g. +15555550123), phone number ID/ARN or pool ID
# texts are sent from. REQUIRED when SMS_PROVIDER=aws.
SMS_ORIGINATION_IDENTITY=

# ARN of the SNS topic AWS End User Messaging publishes inbound (two-way) texts
# to. /api/sms/inbound rejects any SNS message from another topic, so inbound
# texting is effectively OFF while this is blank.
SMS_INBOUND_SNS_TOPIC_ARN=

# Optional: configuration set name or ARN (delivery events, opt-out list).
SMS_CONFIGURATION_SET=

# 'mock' (default, deterministic rules for demos) or 'bedrock' (Claude on
# Amazon Bedrock via the Converse API).
AI_PROVIDER=

# Bedrock model or inference-profile ID, REQUIRED when AI_PROVIDER=bedrock.
# Pilot default: Claude Haiku 4.5 (us.anthropic.claude-haiku-4-5-20251001-v1:0). Cheaper later: us.anthropic.claude-haiku-5-5
# Any current Claude model works: the adapter uses toolChoice "auto" (newer models
# reject a forced tool) and treats a missing/invalid sms_turn call as an error
# (nothing is sent; staff get an amber "AI error" item). Some regions need an
# inference profile ID instead (e.g. us.anthropic.…) — copy it from the Bedrock console.
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# Shared secret for the outreach scheduler (AWS EventBridge Scheduler / Lambda):
#   POST /api/sms/outreach/tick  with  Authorization: Bearer <token>
# At least 16 characters; generate with: openssl rand -base64 32
# Blank = only a signed-in admin can run outreach ("Run outreach now" in Settings).
OUTREACH_CRON_TOKEN=

# Clinic phone number shown in texts ({{clinic_phone}}). Must be the only phone
# number the AI may write (besides 911 / 988). Default: (555) 555-0123
CLINIC_PHONE_NUMBER=

# Clinic name used in texts ({{clinic_name}}). Must NOT reveal a condition
# (AGENT_SAFETY_RULES R3.4). Default: Community Health Clinic
CLINIC_DISPLAY_NAME=

# ── Production container only (set by infra/ on AWS; ignore for local dev) ────

# docker-entrypoint.sh builds DATABASE_URL from these when DATABASE_URL is blank.
# DB_USER / DB_PASSWORD come from the Secrets Manager secret relay/database.
# DB_HOST=
# DB_PORT=5432
# DB_NAME=relay
# DB_USER=
# DB_PASSWORD=

# 'false' to skip `node scripts/db.mjs migrate` at container start. Default: true
# MIGRATE_ON_START=true
