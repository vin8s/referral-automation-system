{
  "app": "npx tsx bin/relay.ts",
  "watch": {
    "include": ["bin/**", "lib/**"]
  },
  "context": {
    "relay:region": "us-east-1",
    "relay:domainName":"relay.example.org",
    "relay:hostedZoneId": "",
    "relay:hostedZoneName": "",
    "relay:cognitoDomainPrefix": "relay-clinic-change-me",
    "relay:alertEmail": "owner@example.org",
    "relay:clinicTimeZone": "America/Los_Angeles",
    "relay:clinicDisplayName": "Example Free Clinic",
    "relay:clinicPhoneNumber": "",
    "relay:smsOriginationIdentity": "",
    "relay:bedrockModelId": "anthropic.claude-haiku-5-5",
    "relay:outreachCron": "cron(0/10 8-17 ? * MON-FRI *)",
    "relay:outreachEnabled": true,
    "relay:pauseTexting": false,
    "relay:subscribeInboundSms": true,
    "relay:budgetWarnUsd": 50,
    "relay:budgetLimitUsd": 100,
    "@aws-cdk/aws-lambda:recognizeLayerVersion": true,
    "@aws-cdk/core:checkSecretUsage": true,
    "@aws-cdk/core:target-partitions": ["aws"],
    "@aws-cdk/aws-ecs:arnFormatIncludesClusterName": true,
    "@aws-cdk/aws-iam:minimizePolicies": true,
    "@aws-cdk/core:validateSnapshotRemovalPolicy": true,
    "@aws-cdk/aws-s3:createDefaultLoggingPolicy": true,
    "@aws-cdk/aws-ec2:restrictDefaultSecurityGroup": true,
    "@aws-cdk/aws-kms:aliasNameRef": true,
    "@aws-cdk/aws-rds:preventRenderingDeprecatedCredentials": true,
    "@aws-cdk/aws-ecs:disableEcsImdsBlocking": true,
    "@aws-cdk/aws-ecs:enableImdsBlockingDeprecatedFeature": false,
    "@aws-cdk/aws-ecs:removeDefaultDeploymentAlarm": true,
    "@aws-cdk/aws-ecs:reduceEc2FargateCloudWatchPermissions": true,
    "@aws-cdk/aws-elasticloadbalancingv2:albDualstackWithoutPublicIpv4SecurityGroupRulesDefault": true,
    "@aws-cdk/aws-lambda:useCdkManagedLogGroup": true
  }
}
